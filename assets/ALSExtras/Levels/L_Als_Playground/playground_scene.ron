    (class: "BuoyancyManager", name: "BuoyancyManager_0", location: (0.0, 0.0, 0.0), rotation_yaw: 0.0, rotation: (pitch: 0.0, yaw: 0.0, roll: 0.0), scale: (1.0, 1.0, 1.0), bounds_origin: (0.0, 0.0, 0.0), bounds_extent: (0.0, 0.0, 0.0)),
    (class: "DefaultPhysicsVolume", name: "DefaultPhysicsVolume_0", location: (0.0, 0.0, 0.0), rotation_yaw: 0.0, rotation: (pitch: 0.0, yaw: 0.0, roll: 0.0), scale: (1.0, 1.0, 1.0), bounds_origin: (0.0, 0.0, 0.0), bounds_extent: (0.0, 0.0, 0.0)),
    (class: "GameplayDebuggerPlayerManager", name: "GameplayDebuggerPlayerManager_0", location: (0.0, 0.0, 0.0), rotation_yaw: 0.0, rotation: (pitch: 0.0, yaw: 0.0, roll: 0.0), scale: (1.0, 1.0, 1.0), bounds_origin: (0.0, 0.0, 0.0), bounds_extent: (0.0, 0.0, 0.0)),
    (class: "TextRenderActor", name: "TextRenderActor10", location: (2987.0, -1234.98, 447.5), rotation_yaw: -180.0, rotation: (pitch: -0.0, yaw: -180.0, roll: -0.0), scale: (1.0, 1.0, 1.0), bounds_origin: (2987.0, -1000.36, 410.0), bounds_extent: (0.0, 234.62, 37.5), text: "The mantle system is fully dynamic and works by tracing\nagainst geometry. It requires no additional pre-defined areas\nand can work on both simple and complex objects.", text_color: (0.462745, 0.8, 0.956863, 1.0), text_world_size: 20.0, text_horizontal_alignment: "EHTA_Left", text_vertical_alignment: "EVRTA_TextTop", text_x_scale: 1.0, text_y_scale: 1.0, text_horizontal_spacing_adjust: 0.0, text_vertical_spacing_adjust: 6.5),
    (class: "B_Als_StaticObject_C", name: "BP_SimpleObject54", location: (2026.78, -2006.07, 50.0), rotation_yaw: 45.0, rotation: (pitch: 0.0, yaw: 45.0, roll: -0.0), scale: (1.0, 1.0, 1.0), bounds_origin: (2026.78, -2006.07, 50.0), bounds_extent: (212.13, 212.13, 150.0), components: [(class: "StaticMeshComponent", name: "StaticMesh", mesh: "/ALS/ALSExtras/Environment/Meshes/SM_Als_Block_3x3.SM_Als_Block_3x3", location: (2026.78, -2006.07, 50.0), rotation: (pitch: 0.0, yaw: 45.0, roll: -0.0), scale: (1.0, 1.0, 1.0), local_box_origin: (0.0, 0.0, 0.0), local_box_extent: (150.0, 150.0, 150.0), world_aabb_center: (2026.78, -2006.07, 50.0), world_aabb_extent: (212.13, 212.13, 150.0))], top_color: (0.18, 0.6, 0.9), side_color: (1.0, 1.0, 1.0), tiling: 1.0),
    (class: "TextRenderActor", name: "TextRenderActor4", location: (-2937.0, 0.0, 275.0), rotation_yaw: 0.0, rotation: (pitch: 0.0, yaw: 0.0, roll: 0.0), scale: (1.0, 1.0, 1.0), bounds_origin: (-2937.0, 0.0, 275.0), bounds_extent: (0.0, 58.85, 15.0), text: "WARNING", text_color: (1.0, 0.407843, 0.34902, 1.0), text_world_size: 30.0, text_horizontal_alignment: "EHTA_Center", text_vertical_alignment: "EVRTA_TextCenter", text_x_scale: 1.0, text_y_scale: 1.0, text_horizontal_spacing_adjust: 0.0, text_vertical_spacing_adjust: 0.0),
    (class: "TextRenderActor", name: "TextRenderActor18", location: (2774.0, -2475.0, 0.0), rotation_yaw: -180.0, rotation: (pitch: -0.0, yaw: -180.0, roll: -0.0), scale: (1.0, 1.0, 1.0), bounds_origin: (2774.0, -2475.0, 25.0), bounds_extent: (0.0, 68.27, 25.0), text: "2.25 M", text_color: (0.462745, 0.8, 0.956863, 1.0), text_world_size: 50.0, text_horizontal_alignment: "EHTA_Center", text_vertical_alignment: "EVRTA_TextBottom", text_x_scale: 1.0, text_y_scale: 1.0, text_horizontal_spacing_adjust: 0.0, text_vertical_spacing_adjust: 0.0),
    (class: "TextRenderActor", name: "TextRenderActor11", location: (2774.0, -1075.0, 0.0), rotation_yaw: -180.0, rotation: (pitch: -0.0, yaw: -180.0, roll: -0.0), scale: (1.0, 1.0, 1.0), bounds_origin: (2774.0, -1075.0, 25.0), bounds_extent: (0.0, 43.27, 25.0), text: ".5 M", text_color: (0.462745, 0.8, 0.956863, 1.0), text_world_size: 50.0, text_horizontal_alignment: "EHTA_Center", text_vertical_alignment: "EVRTA_TextBottom", text_x_scale: 1.0, text_y_scale: 1.0, text_horizontal_spacing_adjust: 0.0, text_vertical_spacing_adjust: 0.0),
    (class: "TextRenderActor", name: "TextRenderActor2_4", location: (-2937.0, 235.0, 247.5), rotation_yaw: 0.0, rotation: (pitch: 0.0, yaw: 0.0, roll: 0.0), scale: (1.0, 1.0, 1.0), bounds_origin: (-2937.0, 2.31, 135.0), bounds_extent: (0.0, 232.69, 112.5), text: "This system is not gameplay ready or feature complete, nor\nwas it intended to be. It exists merely to provide an example\nof what more advanced animation setups can look like. As\nsuch, much of the existing gameplay logic is meant to be\nreplaced with more sophisticated systems on a\nbasis. Please do not expect to be able to throw some things\ninto this and have a full game, and understand that working\nwith this system effectively does require prior game dev\nknowledge and experience.", text_color: (0.462745, 0.8, 0.956863, 1.0), text_world_size: 20.0, text_horizontal_alignment: "EHTA_Left", text_vertical_alignment: "EVRTA_TextTop", text_x_scale: 1.0, text_y_scale: 1.0, text_horizontal_spacing_adjust: 0.0, text_vertical_spacing_adjust: 6.5),
    (class: "TextRenderActor", name: "TextRenderActor8", location: (235.0, 2937.0, 247.5), rotation_yaw: -90.0, rotation: (pitch: -0.0, yaw: -90.0, roll: -0.0), scale: (1.0, 1.0, 1.0), bounds_origin: (2.3, 2937.0, 210.0), bounds_extent: (232.69, 0.0, 37.5), text: "The current foot offset implentation is fairly basic, and\nalthough it works well for general purposes, it may not\nfunction ideally in all scenarios, such as super steep inclines.", text_color: (0.462745, 0.8, 0.956863, 1.0), text_world_size: 20.0, text_horizontal_alignment: "EHTA_Left", text_vertical_alignment: "EVRTA_TextTop", text_x_scale: 1.0, text_y_scale: 1.0, text_horizontal_spacing_adjust: 0.0, text_vertical_spacing_adjust: 6.5),
